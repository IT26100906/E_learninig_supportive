@startuml
title Student Account Management - Class Diagram
skinparam classAttributeIconSize 0
skinparam shadowing false

abstract class User {
  -id : String
  -name : String
  -email : String
  -passwordHash : String
  -phone : String
  -dateOfBirth : LocalDate
  -address : String
  -status : AccountStatus
  -registeredDate : LocalDate
  -lastLogin : LocalDateTime
  -profilePicture : String
  -securityQuestion : String
  -securityAnswerHash : String
  +getRole() : String {abstract}
  +getType() : String {abstract}
  +canManageUsers() : boolean {abstract}
  +getHomePath() : String {abstract}
  +getMaxEnrollments() : int {abstract}
  +isActive() : boolean
  +toFileLine() : String
  +getters / setters
}
class Student { +getMembershipLabel() : String }
class PremiumStudent
class Admin
enum StudentLevel { CHILD\nSCHOOL\nAL\nUNDERGRAD\n--\ngreeting()\nsubjects()\nisValidDetail()\ndescribe()\nhighlight() }
enum AccountStatus { ACTIVE\nINACTIVE }
class UserFactory { +create(...) : User\n+fromFileLine(line) : User }
class Page<T> { items, page, totalPages }

interface UserRepository {
  +findAll() : List<User>
  +findById(id) : Optional<User>
  +findByEmail(email) : Optional<User>
  +create(user)
  +update(user)
  +delete(id) : boolean
}
class JdbcUserRepository { -table users (H2 / MySQL) }
class FileUserRepository { -users.txt (one-time import) }
class UserService {
  +register(...) : Student
  +login(idOrEmail, pw) : User
  +search(...) : Page<User>
  +updateProfile(...)
  +adminUpdate(...)
  +changePassword(...)
  +resetPassword(...)
  +delete(id)
  +exportCsv() : String
}
class PasswordUtil { +hash() +verify() }
class Validator
class ValidationException
class AuthException

abstract class BaseServlet
class LoginServlet
class RegisterServlet
class ProfileServlet
class ChangePasswordServlet
class DashboardServlet
class PhotoServlet
class AdminStudentsServlet
class AdminStudentFormServlet
class AuthFilter

User <|-- Student
Student <|-- PremiumStudent
User <|-- Admin
User --> AccountStatus
User --> StudentLevel
UserFactory ..> User : creates
UserRepository <|.. JdbcUserRepository
UserRepository <|.. FileUserRepository
JdbcUserRepository ..> UserFactory
JdbcUserRepository ..> FileUserRepository : imports old file once
UserService --> UserRepository
UserService ..> PasswordUtil
UserService ..> Validator
UserService ..> ValidationException
UserService ..> AuthException
UserService ..> Page
BaseServlet --> UserService
BaseServlet <|-- LoginServlet
BaseServlet <|-- RegisterServlet
BaseServlet <|-- ProfileServlet
BaseServlet <|-- ChangePasswordServlet
BaseServlet <|-- DashboardServlet
BaseServlet <|-- PhotoServlet
BaseServlet <|-- AdminStudentsServlet
BaseServlet <|-- AdminStudentFormServlet
AuthFilter ..> UserRepository
@enduml
